# Actual Budget CSV Importer
# Copy this file to .env and adjust values for your host.

# Image published by GitHub Actions / GHCR
IMPORTER_IMAGE=ghcr.io/covenn604/actual-budget-csv-importer:latest

# Optional container name
IMPORTER_CONTAINER_NAME=actual-budget-csv-importer

# Host port used to open the web interface
IMPORTER_PORT=8080

# Persistent storage on the Docker host.
# Examples:
# TrueNAS: /mnt/tank/apps/actual-budget-csv-importer
# Linux:   /opt/actual-budget-csv-importer
IMPORTER_DATA_PATH=./data

# Path on the Docker HOST to the CA/server certificate used by Actual.
# Only required for self-signed/private certificates.
#
# If you use a publicly trusted certificate and do not need this,
# create a harmless local cert mount or adjust docker-compose.yml
# to remove the certificate volume/environment entries.
ACTUAL_CA_CERT_PATH=./certs/actual-server.crt

# Path INSIDE the importer container.
NODE_EXTRA_CA_CERTS=/certs/actual-server.crt
